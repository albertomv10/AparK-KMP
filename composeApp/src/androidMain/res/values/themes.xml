<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
      El tema de la app. `forceDarkAllowed=false` porque la app tiene su propio modo oscuro, el que se
      elige en Cuenta: sin esto, el modo oscuro forzado de MIUI/HyperOS (Xiaomi) la oscurecía por su
      cuenta, y con ella el splash (spec 018).
    -->
    <style name="Theme.AparK" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
    </style>

    <!--
      El tema con el que arranca la actividad: el splash de `core-splashscreen`, el mismo de Android 7
      a 15. Fondo blanco siempre, como el de iOS —no hay `values-night` a propósito—, y el logo como
      vector cuadrado con su margen (`splash_logo`). `installSplashScreen()`, en MainActivity, lo
      cambia por `Theme.AparK` en cuanto la app pinta.
    -->
    <style name="Theme.AparK.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.AparK</item>
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
    </style>
</resources>

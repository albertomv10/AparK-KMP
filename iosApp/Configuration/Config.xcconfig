TEAM_ID=

PRODUCT_NAME=Apark
PRODUCT_BUNDLE_IDENTIFIER=com.albertomedina.apark.Apark

// La versión de iOS vive SOLO aquí, y tiene que coincidir con la de Android en
// gradle/libs.versions.toml (app-version-name y app-version-code).
// No la cambies desde la pestaña General de Xcode: la escribe en el target, en
// project.pbxproj, y desde ahí pisa a este fichero sin avisar. Así estuvo hasta
// la 1.1.0: estos valores no llegaban a la app.
CURRENT_PROJECT_VERSION=3
MARKETING_VERSION=1.1.0

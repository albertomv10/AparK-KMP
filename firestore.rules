rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User profiles: only the owner can read/write their own document
    match /users/{userId} {
      allow read, create, delete: if request.auth != null
                                  && request.auth.uid == userId;

      // The name is free text that other members see on their cards, so it is validated — but
      // only when it changes. Checking it on every write would lock out documents that were
      // seeded from a long Google displayName before this rule existed: they could not even
      // reorder their vehicles. The `propagateUserProfile` function copies it into the vehicles.
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && (
                      !request.resource.data.diff(resource.data).affectedKeys().hasAny(['name'])
                      || (
                        request.resource.data.name is string
                        && request.resource.data.name.size() > 0
                        && request.resource.data.name.size() <= 40
                      )
                    );
    }

    // Invitations are handled entirely by Cloud Functions, which use the Admin SDK and bypass
    // these rules. Denying every client access is the point: it stops invite codes being
    // enumerated, and stops a tampered client minting itself an invitation that never expires.
    match /invites/{code} {
      allow read, write: if false;
    }

    // Vehicles collection
    // ---- Vehicle data (spec 015; the catalogue is section 9 of docs/DATA-MODEL.md) ----
    // Closed lists are stored as codes and checked against them; "" means "no data", which is also
    // what a missing field reads as. Free text is bounded.
    function vehicleTypeOk(d) {
      return d.get('type', '') in ['', 'car', 'motorcycle', 'van', 'motorhome', 'other'];
    }
    function powertrainOk(d) {
      return d.get('powertrain', '') in
        ['', 'combustion', 'mild_hybrid', 'hybrid', 'plug_in_hybrid', 'electric', 'fuel_cell', 'other'];
    }
    function fuelOk(d) {
      return d.get('fuel', '') in ['', 'petrol', 'diesel', 'lpg', 'natural_gas', 'hydrogen', 'other'];
    }
    function colorOk(d) {
      return d.get('color', '') in ['', 'white', 'black', 'grey', 'silver', 'blue', 'red', 'green',
                                    'yellow', 'orange', 'brown', 'pink', 'purple'];
    }
    function emissionsLabelOk(d) {
      return d.get('emissionsLabel', '') in ['', 'zero', 'eco', 'c', 'b', 'none'];
    }
    function textOk(d, field, max) {
      return d.get(field, '') is string && d.get(field, '').size() <= max;
    }
    function vehicleNameOk(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 60;
    }

    // Every field, for a vehicle being created.
    function vehicleDataOk(d) {
      return vehicleTypeOk(d) && powertrainOk(d) && fuelOk(d) && colorOk(d) && emissionsLabelOk(d)
          && textOk(d, 'make', 40) && textOk(d, 'model', 40);
    }

    // Only the fields that change, for an update. Checking them all would let one value written
    // before its rule existed lock the owner out of every later write — parking included, since
    // the owner parks through the same branch.
    function vehicleFieldChanged(field) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([field]);
    }
    function changedVehicleDataOk() {
      let d = request.resource.data;
      return (!vehicleFieldChanged('name') || vehicleNameOk(d))
          && (!vehicleFieldChanged('licensePlate') || textOk(d, 'licensePlate', 15))
          && (!vehicleFieldChanged('type') || vehicleTypeOk(d))
          && (!vehicleFieldChanged('powertrain') || powertrainOk(d))
          && (!vehicleFieldChanged('fuel') || fuelOk(d))
          && (!vehicleFieldChanged('color') || colorOk(d))
          && (!vehicleFieldChanged('emissionsLabel') || emissionsLabelOk(d))
          && (!vehicleFieldChanged('make') || textOk(d, 'make', 40))
          && (!vehicleFieldChanged('model') || textOk(d, 'model', 40));
    }

    match /vehicles/{vehicleId} {

      // Membership lives in one array, owner included, because that is what makes it queryable:
      // `where("memberIds", "array-contains", uid)` is a query Firestore can prove is safe from
      // its filters alone, so it never returns a document the caller may not read. Deriving the
      // list from an array of ids held elsewhere could not offer that guarantee, and reading a
      // vehicle that had since been deleted came back as PERMISSION_DENIED — see spec 008.
      allow read: if request.auth != null
                  && request.auth.uid in resource.data.memberIds;

      // Create: the caller must claim ownership and be the only member. Optional fields are read
      // defensively because empty defaults may be omitted on write.
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.ownerId
                    && request.resource.data.memberIds == [request.auth.uid]
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 60
                    && request.resource.data.get('licensePlate', '') is string
                    && request.resource.data.get('licensePlate', '').size() <= 15
                    && request.resource.data.get('lastLocation', null) == null
                    && vehicleDataOk(request.resource.data);

      // Delete: owner only
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.ownerId;

      // Update: the owner may change anything; a member may only park the vehicle, or leave it.
      allow update: if request.auth != null && (
        (
          // The owner may change anything except their own membership. Without that second
          // condition the owner can drop themselves from memberIds, and the vehicle becomes
          // unreadable to the very person who still owns and can delete it.
          request.auth.uid == resource.data.ownerId
          && request.auth.uid in request.resource.data.memberIds
          // Ownership only goes to someone who is already a member: otherwise the vehicle would
          // end up with an owner who cannot even read it (spec 014).
          && request.resource.data.ownerId in request.resource.data.memberIds
          // The owner may remove members but never add them. Joining goes through an invite code
          // and `joinVehicleWithCode`, which uses the Admin SDK; that is what gives an invitation
          // any meaning (spec 014).
          && request.resource.data.memberIds.hasOnly(resource.data.memberIds)
          // Its data, validated only where it changes (spec 015).
          && changedVehicleDataOk()
        )
        ||
        (
          // Parking: only the location changes, and only with the caller's own email on it.
          request.auth.uid in resource.data.memberIds
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['lastLocation', 'updatedAt'])
          && request.resource.data.lastLocation.user.email == request.auth.token.email
        )
        ||
        (
          // Leaving: the caller may drop themselves, and only themselves, from memberIds.
          // The owner is barred from this branch: they are inside the array now, and letting
          // them out would leave a vehicle whose owner cannot read it.
          request.auth.uid in resource.data.memberIds
          && request.auth.uid != resource.data.ownerId
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['memberIds', 'updatedAt'])
          && !(request.auth.uid in request.resource.data.memberIds)
          && resource.data.memberIds.removeAll([request.auth.uid]) == request.resource.data.memberIds
        )
      );

      // Incidents (spec 019): what is wrong with the vehicle, reported and resolved by its members.
      // Every rule reads the parent vehicle with `get()` to check membership, so a vehicle that has
      // been deleted takes its incidents' access with it — the cleanup function then deletes them.
      match /incidents/{incidentId} {
        function vehicle() {
          return get(/databases/$(database)/documents/vehicles/$(vehicleId)).data;
        }
        function isVehicleMember() {
          return request.auth != null && request.auth.uid in vehicle().memberIds;
        }
        function incidentCategoryOk(d) {
          return d.category in ['levels', 'mechanics', 'tyres', 'body', 'other'];
        }
        // A tag is optional, and when present it must belong to the incident's category.
        function incidentTagOk(d) {
          return d.tag == ''
              || (d.category == 'levels'
                  && d.tag in ['low_fuel', 'low_charge', 'oil', 'washer_fluid', 'adblue'])
              || (d.category == 'mechanics'
                  && d.tag in ['warning_light', 'wont_start', 'breakdown', 'strange_noise', 'bulb_out'])
              || (d.category == 'tyres'
                  && d.tag in ['puncture', 'low_pressure', 'tyre_wear'])
              || (d.category == 'body'
                  && d.tag in ['damage', 'cleaning', 'items_inside']);
        }
        function resolutionKeys() {
          return ['status', 'resolvedBy', 'resolvedAt', 'expiresAt'];
        }

        allow read: if isVehicleMember();

        // Reporting: always open, always by the caller, always at the server's time. The time is
        // the server's so that a report written offline still passes when it reaches the server.
        allow create: if isVehicleMember()
                      && request.resource.data.keys().hasOnly(
                           ['category', 'tag', 'note', 'status', 'reportedBy', 'createdAt'])
                      && incidentCategoryOk(request.resource.data)
                      && request.resource.data.tag is string
                      && incidentTagOk(request.resource.data)
                      && request.resource.data.note is string
                      && request.resource.data.note.size() <= 280
                      && request.resource.data.status == 'open'
                      && request.resource.data.reportedBy == request.auth.uid
                      && request.resource.data.createdAt == request.time;

        // Any member may resolve an incident, or undo that. Nothing else about it ever changes:
        // an incident is not edited, it is deleted and reported again.
        allow update: if isVehicleMember()
                      && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(resolutionKeys())
                      && (
                        (
                          // Resolving. `expiresAt` is the TTL field: the resolved incident is
                          // deleted 30 days later. The phone computes it, so it is only capped.
                          resource.data.status == 'open'
                          && request.resource.data.status == 'resolved'
                          && request.resource.data.resolvedBy == request.auth.uid
                          && request.resource.data.resolvedAt == request.time
                          && request.resource.data.expiresAt is timestamp
                          && request.resource.data.expiresAt <= request.time + duration.value(31, 'd')
                        )
                        ||
                        (
                          // Undoing: back to open, and without the three resolution fields.
                          resource.data.status == 'resolved'
                          && request.resource.data.status == 'open'
                          && !request.resource.data.keys().hasAny(['resolvedBy', 'resolvedAt', 'expiresAt'])
                        )
                      );

        // Deleting is for correcting mistakes: the reporter, or the vehicle's owner.
        allow delete: if isVehicleMember()
                      && (resource.data.reportedBy == request.auth.uid
                          || vehicle().ownerId == request.auth.uid);
      }
    }
  }
}

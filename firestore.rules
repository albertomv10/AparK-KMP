rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User profiles: only the owner can read/write their own document
    match /users/{userId} {
      allow read, write: if request.auth != null
                          && request.auth.uid == userId;
    }

    // Vehicles collection
    match /vehicles/{vehicleId} {

      // Read: owner or any shared user
      allow read: if request.auth != null
                  && (request.auth.uid == resource.data.ownerId
                      || request.auth.uid in resource.data.sharedUsers);

      // Create: caller must claim ownership and provide a valid, "empty" vehicle
      // (no shared users and no location yet). Optional fields are read defensively
      // because empty defaults (licensePlate, sharedUsers) may be omitted on write.
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.ownerId
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 60
                    && request.resource.data.get('licensePlate', '') is string
                    && request.resource.data.get('licensePlate', '').size() <= 15
                    && request.resource.data.get('sharedUsers', []).size() == 0
                    && request.resource.data.get('lastLocation', null) == null;

      // Delete: owner only
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.ownerId;

      // Update: owner may change anything;
      // shared users may only update lastLocation and must set their own email
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.ownerId
        ||
        (
          request.auth.uid in resource.data.sharedUsers
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLocation'])
          && request.resource.data.lastLocation.user.email == request.auth.token.email
        )
      );
    }
  }
}

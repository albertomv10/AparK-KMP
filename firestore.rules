rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User profiles: only the owner can read/write their own document
    match /users/{userId} {
      allow read, write: if request.auth != null
                          && request.auth.uid == userId;
    }

    // Invitations are handled entirely by Cloud Functions, which use the Admin SDK and bypass
    // these rules. Denying every client access is the point: it stops invite codes being
    // enumerated, and stops a tampered client minting itself an invitation that never expires.
    match /invites/{code} {
      allow read, write: if false;
    }

    // Vehicles collection
    match /vehicles/{vehicleId} {

      // Read: owner or any shared user
      allow read: if request.auth != null
                  && (request.auth.uid == resource.data.ownerId
                      || request.auth.uid in resource.data.sharedUsers);

      // Create: caller must claim ownership and provide a valid, "empty" vehicle
      // (no shared users and no location yet). Optional fields are read defensively
      // because empty defaults (licensePlate, sharedUsers) may be omitted on write.
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.ownerId
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 60
                    && request.resource.data.get('licensePlate', '') is string
                    && request.resource.data.get('licensePlate', '').size() <= 15
                    && request.resource.data.get('sharedUsers', []).size() == 0
                    && request.resource.data.get('lastLocation', null) == null;

      // Delete: owner only
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.ownerId;

      // Update: owner may change anything; shared users may only update lastLocation
      // (setting their own email), or leave the vehicle by removing themselves.
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.ownerId
        ||
        (
          request.auth.uid in resource.data.sharedUsers
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLocation'])
          && request.resource.data.lastLocation.user.email == request.auth.token.email
        )
        ||
        (
          // Leaving: the caller may drop themselves, and only themselves, from sharedUsers.
          request.auth.uid in resource.data.sharedUsers
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sharedUsers'])
          && !(request.auth.uid in request.resource.data.sharedUsers)
          && resource.data.sharedUsers.removeAll([request.auth.uid]) == request.resource.data.sharedUsers
        )
      );
    }
  }
}
